{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": false,
		"rewriteRelativeImportExtensions": true,
		"types": ["node"]
	}
}
