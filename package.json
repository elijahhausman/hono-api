{
	"name": "turborepo",
	"private": true,
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"start": "turbo run start",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"type": "turbo run type"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"turbo": "^2.10.12",
		"typescript": "catalog:"
	},
	"engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "warn"
    }
  },
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
